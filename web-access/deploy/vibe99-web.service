[Unit]
Description=Vibe99 Web Access (persistent terminal sessions over WebSocket)
After=network.target

[Service]
Type=simple
WorkingDirectory=__VIBE99_REPO__/web-access
Environment=NODE_ENV=production
Environment=VIBE99_WEB_CONFIG=%h/.config/vibe99-web/config.json
# Generate this template with README instructions so __NODE_BIN__ points to Node 22.
ExecStart=__NODE_BIN__ __VIBE99_REPO__/web-access/server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

# Install (user session, no sudo needed):
#   cd /path/to/Vibe99
#   mkdir -p ~/.config/systemd/user
#   sed -e "s#__VIBE99_REPO__#$(pwd)#g" -e "s#__NODE_BIN__#$(command -v node)#g" web-access/deploy/vibe99-web.service > ~/.config/systemd/user/vibe99-web.service
#   loginctl enable-linger $USER            # keep the user session (and this service) alive after logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now vibe99-web
# Logs: journalctl --user -u vibe99-web -f
